# Both optional — the pipeline runs without them, just with those sources skipped/rate-limited.

# GitHub PAT (public_repo scope) — raises the GitHub search API limit from 60/hr to 5,000/hr,
# and is used to look up public emails on the GitHub-enricher source.
GITHUB_PAT=

# Product Hunt GraphQL developer token (free, from https://api.producthunt.com/v2/oauth/applications)
# Without this, the Product Hunt discovery source is skipped.
PRODUCTHUNT_TOKEN=

# Gmail read-only reply sync. From a Google Cloud project with the Gmail API
# enabled and an OAuth client (type: Web application, redirect URI:
# http://localhost:3000/api/auth/gmail/callback). Without these, the
# "Connect Gmail" button in Settings just explains they're missing.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
